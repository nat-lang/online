use context as context

let output = [];
let doc = x => GuideTexDoc(x, context.window.center);

let prefix typeset = output.push . doc;
let prefix codeblock = output.push . Codeblock;
let prefix markdown = out.push . Markdown;

let prefix print = x => {
  if (vmType(x) == OInstance && callable(x.viz))
    output.push(x.viz());
  else if (vmType(x) == OInstance && callable(x.print))
    x.print();
  else
    __print__(x);
};

let anchor = (title, tex) => {
  output.push(
    Anchor(
      title,
      context.path,
      Markdown("[#{title}](#{context.host}#{context.path}/#{title})")
    )
  );
};

let main = () => Generator(output, serialize);