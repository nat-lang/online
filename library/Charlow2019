use ../online/common

dom t = {true, false};

// Let the compiler know that the native
// boolean type [bool] now has an extension.
bool = t;

sym David, James;
dom e = {David, James};

// Define the [grammar] object, which will keep
// track of our composition rules and lexical entries.
let grammar = CompositionSystem();

let a = num -> e;

let AssSensitiveFunctionApplication
  = (a: a -> x -> y, b: a -> x) => (g => a(g)(b(g)))
  | (a: a -> x, b: a -> x -> y) => (g => b(g)(a(g)));

let PredicateAbstraction
  = (n: num, f: a -> u) => (g x => f(g[n] = x))
  | (f: a -> u, n: num) => (g x => f(g[n] = x));

grammar.addRule(PredicateAbstraction);
grammar.addRule(AssSensitiveFunctionApplication);

let a = num -> e;
let Human = {David, James};

let eta: (a -> u) -> a -> {u} = e g => ({e(g)});
let who: a -> (e -> {t}) -> {t} = g f => ({y | x in Human, y in f(x)});
let did: a -> u -> u = g x => x;

let Meet = {(David, James), (James, David)};
let meet: a -> e -> e -> t = g x y => (x,y) in Meet;
let J = (g: a) => James;

let pronoun: num -> (num -> e) -> e = n g => g[n];
let trace = pronoun;

let prefix ex = output.push . StandaloneTexDoc . (x => x.tex()) . grammar.evaluate;

markdown "Here are basic illustrations of the unit and bind operations selectively
introducing indeterminacy into derivations.";

markdown "(1) Who did James meet?";

ex [who [1 [did [.eta J [meet trace(1)]]]]];

let Linguist = {David};
let a-ling: a -> {e} = g => ({x | x in Linguist});

let bind
  : (a -> {u}) -> a -> (u -> {w}) -> {w}
  = m g f => ({y | z in m(g), y in f(z)});

markdown "(2) James met a linguist.";
ex [[.bind a-ling] [1 [.eta J [meet trace(1)]]]];
